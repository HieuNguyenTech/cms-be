NODE_ENV=development
PORT=8000

MONGODB_URI=mongodb://localhost:27017/cms?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Required only on first start, while the user collection is empty (password: 12-72 bytes).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma separated. Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# Empty when clients connect directly. Behind a reverse proxy, set its IP or CIDR.
TRUST_PROXY=
